# Database
DATABASE_URL=sqlite+aiosqlite:///./study_assistant.db


# Application
APP_NAME=Study Assistant
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

AI_PROVIDER=groq
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile


# Voice
VOICE_ENABLED=true
TTS_ENGINE=pyttsx3

# Notifications
NOTIFICATION_ENABLED=true
